<style>
body{
    margin:0;
    font-family:Arial, sans-serif;
    background:#0e1117;
    color:white;
}

/* HEADER */
header{
    padding:20px;
    background:#161b22;
    position:sticky;
    top:0;
    z-index:1000;
    border-bottom:1px solid rgba(255,255,255,0.1);
}

h1{
    margin:0 0 15px;
    font-size:28px;
}

/* CONTROLS */
.controls{
    display:flex;
    gap:15px;
    flex-wrap:wrap;
    align-items:center;
}

input{
    padding:10px;
    border:none;
    border-radius:10px;
    background:#21262d;
    color:white;
    outline:none;
    flex:1;
    min-width:200px;
}

.toggle{
    display:flex;
    align-items:center;
    gap:10px;
    background:#21262d;
    padding:10px 15px;
    border-radius:10px;
}

/* SWITCH */
.toggle input{
    width:18px;
    height:18px;
}

/* GALLERY */
.gallery{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(350px,1fr));
    gap:20px;
    padding:20px;
}

/* MODEL CARD */
.model{
    background:#161b22;
    border-radius:15px;
    overflow:hidden;
    transition:0.3s;
    border:1px solid rgba(255,255,255,0.08);
}

.model:hover{
    transform:translateY(-6px);
    box-shadow:0 10px 25px rgba(0,0,0,0.5);
}

.model iframe{
    width:100%;
    height:260px;
    border:none;
}

.info{
    padding:12px;
    font-size:14px;
}

/* BADGES */
.badge{
    display:inline-block;
    margin-top:6px;
    padding:4px 10px;
    border-radius:999px;
    font-size:12px;
}

.safe{ background:#2ecc71; }
.nsfw{ background:#e74c3c; }

/* HIDE */
.hidden{
    display:none;
}

/* ANIMATION LOAD */
.model{
    opacity:0;
    transform:translateY(20px);
    animation:fadeIn 0.5s forwards;
}

@keyframes fadeIn{
    to{
        opacity:1;
        transform:translateY(0);
    }
}
</style>
</head>

