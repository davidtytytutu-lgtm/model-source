<script>

const search = document.getElementById("search");
const toggle = document.getElementById("nsfwToggle");
const models = document.querySelectorAll(".model");

function update(){

    const value = search.value.toLowerCase();

    models.forEach(model => {

        const title = model.querySelector("iframe").title.toLowerCase();
        const nsfw = model.dataset.nsfw === "true";

        let show = true;

        if(!title.includes(value)) show = false;

        if(nsfw && !toggle.checked) show = false;

        model.classList.toggle("hidden", !show);

    });

}

search.addEventListener("input", update);
toggle.addEventListener("change", update);

update();

</script>

